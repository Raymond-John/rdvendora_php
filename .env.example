# Copy this file to .env and fill in Hostinger values.
# Never upload a filled .env to a public Git repo.

APP_NAME="RD Vendora"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.com

DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_hostinger_database
DB_USER=your_hostinger_db_user
DB_PASS=your_hostinger_db_password
DB_CHARSET=utf8mb4

# SMTP (Admin settings in the database take priority when present)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=tls
SMTP_FROM=
SMTP_FROM_NAME="RD Vendora"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://yourdomain.com/oauth2callback.php

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=

GROQ_API_KEY=
