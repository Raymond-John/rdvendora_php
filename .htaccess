Options -Indexes
ServerSignature Off

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<Files ".env">
    Require all denied
</Files>
<Files ".env.example">
    Require all denied
</Files>
<Files "composer.json">
    Require all denied
</Files>
<Files "composer.lock">
    Require all denied
</Files>
<FilesMatch "\.(sql|env|log)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block private application folders
    RewriteRule ^(app|storage|vendor|archive|config|database)(/|$) - [F,L]

    # Legacy customer auth aliases
    RewriteRule ^login-customer/?$ login [R=301,L,QSA]
    RewriteRule ^register-customer/?$ register [R=301,L,QSA]
    RewriteRule ^login-customer\.php$ login [R=301,L,QSA]
    RewriteRule ^register-customer\.php$ register [R=301,L,QSA]

    # Sitemap + favicon
    RewriteRule ^sitemap\.xml$ sitemap.xml.php [L]
    RewriteRule ^favicon\.ico$ assets/brand-logo.png [L]

    # Old admin URLs at site root → /admin/...
    RewriteRule ^admin\.php$ admin/admin [R=301,L,QSA]
    RewriteRule ^admin_login\.php$ admin/admin_login [R=301,L,QSA]
    RewriteRule ^admin_register\.php$ admin/admin_register [R=301,L,QSA]
    RewriteRule ^adminsettings\.php$ admin/adminsettings [R=301,L,QSA]
    RewriteRule ^admin-([a-z0-9-]+)\.php$ admin/admin-$1 [R=301,L,QSA]

    # Canonical HTTPS apex on live
    RewriteCond %{HTTP_HOST} ^(www\.)?rdvendora\.com$ [NC]
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://rdvendora.com%{REQUEST_URI} [L,R=301]
    RewriteCond %{HTTP_HOST} ^www\.rdvendora\.com$ [NC]
    RewriteRule ^ https://rdvendora.com%{REQUEST_URI} [L,R=301]

    # ----- Clean URLs: hide .php from the browser -----
    # Relative redirects (no leading /) keep XAMPP subfolders + Hostinger root working.
    # Keep POST/PUT/PATCH to *.php intact (forms, webhooks, OAuth callbacks)
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
    RewriteCond %{THE_REQUEST} \s[^?\s]*index\.php[\s?] [NC]
    RewriteRule ^index\.php$ ./ [R=301,L]

    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
    RewriteCond %{THE_REQUEST} \s[^?\s]*admin/([^\s?]+)\.php[\s?] [NC]
    RewriteRule ^admin/.+\.php$ admin/%1 [R=301,L,QSA]

    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
    RewriteCond %{THE_REQUEST} \s[^?\s]*([^\s?]*)\.php[\s?] [NC]
    RewriteCond %1 !sitemap\.xml$ [NC]
    RewriteRule ^(.+)\.php$ $1 [R=301,L,QSA]

    # Serve existing files/directories as-is (assets, uploads, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # /admin → admin/admin.php ; /admin/page → admin/page.php
    RewriteRule ^admin/?$ admin/admin.php [L,QSA]
    RewriteCond %{DOCUMENT_ROOT}/admin/$1.php -f
    RewriteRule ^admin/([A-Za-z0-9_-]+)/?$ admin/$1.php [L,QSA]
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^admin/([A-Za-z0-9_-]+)/?$ admin/$1.php [L,QSA]

    # /page → page.php when that script exists
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [L,QSA]

    # ----- Store path URLs (only when no matching .php page) -----
    # /{slug}/product/{id}-{name}
    RewriteRule ^([a-z0-9]+(?:-[a-z0-9]+)*)/product/([0-9]+)(?:-[a-z0-9-]+)?/?$ product-details.php?slug=$1&id=$2 [L,QSA]

    # /{slug}/category/{category}
    RewriteRule ^([a-z0-9]+(?:-[a-z0-9]+)*)/category/(.+)/?$ storefront.php?slug=$1&cat=$2 [L,QSA]

    # /{slug} → storefront (PHP validates reserved + DB)
    RewriteRule ^([a-z0-9]+(?:-[a-z0-9]+)*)/?$ storefront.php?slug=$1 [L,QSA]

    # Optional legacy store subdomains
    RewriteCond %{HTTP_HOST} ^([a-z0-9]([a-z0-9-]*[a-z0-9])?)\.rdvendora\.com$ [NC]
    RewriteCond %1 !^www$ [NC]
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    RewriteCond %{HTTP_HOST} ^([a-z0-9]([a-z0-9-]*[a-z0-9])?)\.rdvendora\.com$ [NC]
    RewriteCond %1 !^www$ [NC]
    RewriteCond %{REQUEST_URI} ^/?$
    RewriteRule ^$ storefront.php [L,QSA]
</IfModule>

ErrorDocument 404 /404
ErrorDocument 403 /403
ErrorDocument 500 /500

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/gif "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType video/mp4 "access plus 30 days"
</IfModule>
