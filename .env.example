# Copy to .env on the server (Hostinger File Manager). Never commit a filled .env.
# Local XAMPP: APP_ENV=local, APP_DEBUG=true, DB_USER=root, DB_PASS= (empty), DB_NAME=rdvendora_db
# Production: APP_ENV=production, APP_DEBUG=false, Hostinger database credentials.

APP_NAME="RD Vendora"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.com

DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_hostinger_database
DB_USER=your_hostinger_db_user
DB_PASS=your_hostinger_db_password
DB_CHARSET=utf8mb4

# SMTP (Admin settings in the database take priority when present)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=tls
SMTP_FROM=
SMTP_FROM_NAME="RD Vendora"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://yourdomain.com/oauth2callback.php

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=

GROQ_API_KEY=

# Advertising — enabled automatically on rdvendora.com
# Optional ad-unit IDs (numbers only) if you create manual placements in AdSense.
ADSENSE_ENABLED=true
ADSENSE_PUBLISHER_ID=pub-7091872948951204
ADSENSE_SLOT_HEADER=
ADSENSE_SLOT_CONTENT=
ADSENSE_SLOT_SIDEBAR=
ADSENSE_SLOT_ARTICLE=
ADSENSE_SLOT_FOOTER=

# Google Analytics 4 measurement ID (or set it in Admin → Settings)
GA_MEASUREMENT_ID=G-2CMDRDJNSM

# Google Search Console HTML tag content only (optional)
GOOGLE_SITE_VERIFICATION=

