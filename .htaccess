Options -Indexes -MultiViews
ServerSignature Off
DirectorySlash Off

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<Files ".env">
    Require all denied
</Files>
<Files ".env.example">
    Require all denied
</Files>
<Files "composer.json">
    Require all denied
</Files>
<Files "composer.lock">
    Require all denied
</Files>
<FilesMatch "\.(sql|env|log)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Exact /vendor → vendor chat (composer lives in /vendor/; do not use [R] here —
    # relative redirects break under subdirectory installs like /RD%20Vendora/)
    RewriteRule ^vendor/?$ vendor-chat.php [L,QSA]

    # Block private application folders / composer package files
    RewriteRule ^(app|storage|archive|config|database)(/|$) - [F,L]
    RewriteRule ^vendor/.+ - [F,L]

    # Legacy customer auth aliases
    RewriteRule ^login-customer/?$ login [R=301,L,QSA]
    RewriteRule ^register-customer/?$ register [R=301,L,QSA]
    RewriteRule ^login-customer\.php$ login [R=301,L,QSA]
    RewriteRule ^register-customer\.php$ register [R=301,L,QSA]

    # Sitemap + favicon
    RewriteRule ^sitemap\.xml$ sitemap.xml.php [L]
    RewriteRule ^favicon\.ico$ assets/brand-logo.png [L]

    # Old admin URLs at site root → /admin/...
    RewriteRule ^admin\.php$ admin/admin [R=301,L,QSA]
    RewriteRule ^admin_login\.php$ admin/admin_login [R=301,L,QSA]
    RewriteRule ^admin_register\.php$ admin/admin_register [R=301,L,QSA]
    RewriteRule ^adminsettings\.php$ admin/adminsettings [R=301,L,QSA]
    RewriteRule ^admin-([a-z0-9-]+)\.php$ admin/admin-$1 [R=301,L,QSA]

    # Canonical HTTPS apex on live
    RewriteCond %{HTTP_HOST} ^(www\.)?rdvendora\.com$ [NC]
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://rdvendora.com%{REQUEST_URI} [L,R=301]
    RewriteCond %{HTTP_HOST} ^www\.rdvendora\.com$ [NC]
    RewriteRule ^ https://rdvendora.com%{REQUEST_URI} [L,R=301]

    # ----- Clean URLs: hide .php from the browser -----
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
    RewriteCond %{THE_REQUEST} \s/+((?:[^?\s]*?/)?)index\.php[\s?] [NC]
    RewriteRule ^index\.php$ /%1 [R=301,L,NE]

    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
    RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.php[\s?] [NC]
    RewriteCond %1 !sitemap\.xml$ [NC]
    RewriteRule ^.+\.php$ /%1 [R=301,L,QSA,NE]

    # Admin clean routes MUST run before treating /admin as a real directory
    # (Options -Indexes otherwise returns a raw 403 on /admin/)
    RewriteRule ^admin/?$ admin/admin.php [L,QSA]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{DOCUMENT_ROOT}/admin/$1.php -f [OR]
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^admin/([A-Za-z0-9_-]+)/?$ admin/$1.php [L,QSA]

    # Serve existing files/directories as-is (assets, uploads, etc.)
    # Skip admin/vendor dirs so they never directory-list/403.
    # Skip /blog/{slug} — LiteSpeed can treat that as blog.php + PATH_INFO
    # (a "file") and 500 before the article rewrite below runs.
    RewriteCond %{REQUEST_URI} !/(admin|vendor)/?$ [NC]
    RewriteCond %{REQUEST_URI} !/blog/.+ [NC]
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # /blog/{slug} → article. Must run before the generic ".php exists" map:
    # Hostinger/LiteSpeed sets REQUEST_FILENAME to .../blog for /blog/slug because
    # blog.php exists, so that map would internally rewrite to a missing
    # blog/slug.php and return a 500.
    RewriteRule ^blog/([a-z0-9-]+)/?$ blog-post.php?slug=$1 [L,QSA]

    # /page → page.php when that script exists (one URL segment only)
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^([A-Za-z0-9_-]+)/?$ $1.php [L,QSA]

    # ----- Store path URLs (only when no matching .php page) -----
    RewriteRule ^([a-z0-9]+(?:-[a-z0-9]+)*)/product/([0-9]+)(?:-[a-z0-9-]+)?/?$ product-details.php?slug=$1&id=$2 [L,QSA]
    RewriteRule ^([a-z0-9]+(?:-[a-z0-9]+)*)/category/(.+)/?$ storefront.php?slug=$1&cat=$2 [L,QSA]
    RewriteRule ^([a-z0-9]+(?:-[a-z0-9]+)*)/?$ storefront.php?slug=$1 [L,QSA]

    # Optional legacy store subdomains
    RewriteCond %{HTTP_HOST} ^([a-z0-9]([a-z0-9-]*[a-z0-9])?)\.rdvendora\.com$ [NC]
    RewriteCond %1 !^www$ [NC]
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    RewriteCond %{HTTP_HOST} ^([a-z0-9]([a-z0-9-]*[a-z0-9])?)\.rdvendora\.com$ [NC]
    RewriteCond %1 !^www$ [NC]
    RewriteCond %{REQUEST_URI} ^/?$
    RewriteRule ^$ storefront.php [L,QSA]
</IfModule>

ErrorDocument 404 /404.php
ErrorDocument 403 /403.php
ErrorDocument 500 /500.php

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/gif "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType video/mp4 "access plus 30 days"
</IfModule>
